<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E052D">

    <!-- Header Logo & Brand -->
    <LinearLayout
        android:id="@+id/layoutLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/cardForm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgLogoIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:padding="12dp"
            android:src="@drawable/logo"
            />

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/name_app"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <!-- White Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintHeight_percent="0.75">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="32dp"
                android:paddingTop="28dp"
                android:paddingBottom="36dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hãy cho chúng tôi biết về bạn"
                    android:textColor="#00D06C"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Gender: Male -->
                <LinearLayout
                    android:id="@+id/layoutMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@+id/layoutFemale"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgMale"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:clickable="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_male"
                        app:shapeAppearanceOverlay="@style/CircularImageView" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Nam"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Gender: Female -->
                <LinearLayout
                    android:id="@+id/layoutFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/layoutMale"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgFemale"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:clickable="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_female"
                        app:shapeAppearanceOverlay="@style/CircularImageView" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Nữ"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Field: Tên -->
                <TextView
                    android:id="@+id/lblTen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Tên:"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@+id/edtTen"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/edtTen"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="#CCCCCC"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:gravity="end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutMale" />

                <!-- Field: Ngày sinh -->
                <TextView
                    android:id="@+id/lblNgaySinh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngày sinh:"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@+id/edtNgaySinh"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/edtNgaySinh"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#CCCCCC"
                    android:gravity="end"
                    android:hint="DD/MM/YYYY"
                    android:inputType="date"
                    android:textColorHint="#999999"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edtTen" />

                <!-- Field: Chiều cao -->
                <TextView
                    android:id="@+id/lblChieuCao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chiều cao:"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@+id/edtChieuCao"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/unitChieuCao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cm"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/edtChieuCao"
                    app:layout_constraintEnd_toEndOf="parent" />

                <EditText
                    android:id="@+id/edtChieuCao"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#CCCCCC"
                    android:gravity="end"
                    android:inputType="number"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@+id/unitChieuCao"
                    app:layout_constraintTop_toBottomOf="@+id/edtNgaySinh" />

                <!-- Field: Cân nặng -->
                <TextView
                    android:id="@+id/lblCanNang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cân nặng:"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@+id/edtCanNang"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/unitCanNang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kg"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/edtCanNang"
                    app:layout_constraintEnd_toEndOf="parent" />

                <EditText
                    android:id="@+id/edtCanNang"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#CCCCCC"
                    android:gravity="end"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@+id/unitCanNang"
                    app:layout_constraintTop_toBottomOf="@+id/edtChieuCao" />

                <!-- Button Tiếp tục -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTiepTuc"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_btn_green"
                    android:text="Tiếp tục"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edtCanNang" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>